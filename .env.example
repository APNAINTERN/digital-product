# API
PORT=4000
# Local Postgres (docker compose up -d) OR Neon/Supabase for production
DATABASE_URL="postgresql://seovision:seovision@localhost:5432/seovision?schema=public"
JWT_SECRET=change-me-to-a-long-random-secret
JWT_EXPIRES_IN=7d
CLIENT_URL=http://localhost:5173
API_URL=http://localhost:4000

# Google OAuth (optional)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:4000/api/auth/google/callback

# AI providers (optional — falls back to heuristic AI advisor)
OPENAI_API_KEY=
GEMINI_API_KEY=

# Third-party SEO APIs (optional — estimates used when unset)
PAGESPEED_API_KEY=
SERPAPI_KEY=
DATAFORSEO_LOGIN=
DATAFORSEO_PASSWORD=

# Email (optional — verification links logged to console in demo mode)
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=noreply@seovision.ai

# Frontend (Vercel) — leave empty when API is same-origin on Vercel
VITE_API_URL=
